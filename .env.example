# Local development template only. Copy to .env; never commit real credentials.
# No application currently reads these variables; wire them into services as they are built.
ASSET_ID=MOTOR_01

# localhost is appropriate only when the broker runs on the same machine as the client.
# ESP32 clients must use the Raspberry Pi/broker's reachable LAN address.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_BASE_TOPIC=motor01
MQTT_KEEPALIVE_SECONDS=60

DATA_DIR=data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
MODEL_PATH=ai/models/random_forest.joblib

# Set these only after sampling, latency and freshness limits are measured.
INFERENCE_WINDOW_SECONDS=
MAX_TELEMETRY_AGE_SECONDS=
DASHBOARD_REFRESH_SECONDS=
